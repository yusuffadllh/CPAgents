generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model Settings {
  id        Int    @id @default(1)
  baseUrl   String @default("https://openrouter.ai/api/v1")
  apiKey    String @default("")
  modelName String @default("google/gemini-2.5-pro")

  // Model used by the chat image-generation endpoint (/api/chat/image).
  imageModelName String @default("gpt-image-1")

  // Deploy credentials — injected as env vars into the agent so it can deploy
  // the project it builds. Empty means that platform is unavailable.
  vercelToken  String @default("")
  netlifyToken String @default("")

  // GitHub push credentials. Without an identity `git commit` aborts with
  // "Please tell me who you are", which is the usual cause of failed commits.
  githubToken    String @default("")
  githubUsername String @default("")
  githubEmail    String @default("")

  // "cli"  = deploy straight from the machine (default).
  // "git"  = push to GitHub only and let the platform's Git integration build,
  //          which avoids the duplicate deployment you get when both run.
  deployMode String @default("cli")
}

model Session {
  id        String    @id @default(uuid())
  goal      String
  // Human-readable folder name for workspaces/<slug>, derived from the goal.
  // Null for sessions created before slugs existed; those still use the id.
  slug      String?   @unique
  createdAt DateTime  @default(now())
  messages  Message[]
  tasks     Task[]
}

model Task {
  id          String   @id @default(uuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id])
  description String
  status      String   @default("PENDING") // PENDING, RUNNING, COMPLETED
  result      String?
  createdAt   DateTime @default(now())
}

model Message {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  role      String   // user, planner, executor
  content   String
  // JSON array of attachments: [{ type: 'image'|'file', name, path, mime, url? }].
  // SQLite has no JSON type; Prisma maps Json to TEXT.
  attachments Json?
  createdAt DateTime @default(now())
}
